// mengundang.id di Cloudflare Workers.
//
// Situsnya statis tanpa langkah build: folder repo ini sendiri yang
// diterbitkan sebagai aset, dikurangi yang disebut di .assetsignore.
// Kode Worker (cloudflare/pintu.js) cuma dijalankan untuk "/" — sisanya
// dilayani lapisan aset langsung, gratis dan tidak terhitung kuota.
{
  "name": "mengundang",
  "main": "cloudflare/pintu.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",

    // /kirim menyajikan kirim/index.html di tempat; /kirim/ dialihkan
    // ke /kirim.
    "html_handling": "drop-trailing-slash",

    // Alamat yang bukan berkas — /budi-sari/ibu-rahayu,
    // rian-aini.mengundang.id/bapak-ahmad — mendapat index.html, dan
    // halaman itu sendiri yang membaca pasangan dan tamunya dari alamat.
    "not_found_handling": "single-page-application",

    // Akar perlu keputusan berdasarkan host; /media/* dilayani dari R2.
    "run_worker_first": ["/", "/media/*"]
  },

  // Foto dan video pasangan (cloudflare/media.js). Unggahan baru ditulis
  // ke sini lewat tiket dari foto-unggah; berkas lama di Supabase
  // disalin ke sini saat pertama dibuka. Rahasia MEDIA_KUNCI dipasang
  // di dashboard (Settings → Variables and Secrets), tidak di repo.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "mengundang-media" }
  ],
  "vars": {
    "SUPABASE_FOTO": "https://mavjlhlyrtacxleulbom.supabase.co/storage/v1/object/public/foto/"
  },

  // Alamat uji: mengundang.<akun>.workers.dev, plus alamat pratinjau
  // per versi. Bentuknya domain bersama, jadi pasangan dibaca dari path
  // (/rian-aini/bapak-ahmad).
  "workers_dev": true,
  "preview_urls": true,

  // Workers Builds menjalankan `wrangler preview` untuk branch selain
  // main (setiap PR), dan perintah itu menuntut blok ini ada — boleh
  // kosong. Aset, rute, dan pengaturan lain tetap di tingkat atas.
  "previews": {},

  // Apex dan semua subdomain. Rute hanya bekerja untuk nama yang
  // rekaman DNS-nya diproxy (awan oranye): AAAA @ 100:: dan AAAA * 100::.
  "routes": [
    { "pattern": "mengundang.id/*",   "zone_name": "mengundang.id" },
    { "pattern": "*.mengundang.id/*", "zone_name": "mengundang.id" }
  ]
}
